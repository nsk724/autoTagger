# ---------- images ----------
# empty locally; e.g. ghcr.io/<org>/ on AWS (note trailing slash)
REGISTRY=
# Jenkins sets the git short SHA
IMAGE_TAG=dev

# ---------- gateway ----------
# host port, bound to 127.0.0.1
GATEWAY_PORT=8080
GATEWAY_HTPASSWD='reviewer1:$2y$05$...\nsmoke:$2y$05$...'
# htpasswd lines joined with \n. MUST be in single quotes: the hashes contain "$",
# which Compose would otherwise try to expand.
# generate one line: docker run --rm httpd:2.4-alpine htpasswd -nbB <user> <pass>
# users: one per reviewer + "smoke"

# ---------- database ----------
# letters and digits only (it is embedded in a URL)
POSTGRES_PASSWORD=change-me
# DATABASE_URL is NOT set here: docker-compose.yml builds it from POSTGRES_PASSWORD
# (nested ${} inside .env does not expand reliably everywhere this file is read)

# ---------- model ----------
HF_MODEL_REPO=<hf-org>/triageiq-classifier
HF_SPACE_REPO=<hf-org>/triageiq-model-service
# local copy: http://model-service:8000
MODEL_SERVICE_URL=https://<hf-org>-triageiq-model-service.hf.space
# = HF_TOKEN_READ for the private Space; empty for the local copy
MODEL_SERVICE_TOKEN=
MODEL_CALL_TIMEOUT_SECONDS=30
# fine-grained, read-only: model repo + Space
HF_TOKEN_READ=
# fine-grained, write: model repo + Space. Jenkins + ML devs ONLY
HF_TOKEN_WRITE=
# used only by the local model-service copy
MODEL_REVISION=main

# ---------- generator ----------
TICKET_INTERVAL_SECONDS=15
DRIFT_ENABLED=false
# tickets sent before drift begins
DRIFT_START_AFTER=100
# share of held-out tickets once drift is on
DRIFT_RATIO=0.4
DRIFT_SEED=42

# ---------- experiment tracking & data (DagsHub) ----------
MLFLOW_TRACKING_URI=https://dagshub.com/<user>/triageiq.mlflow
MLFLOW_TRACKING_USERNAME=<dagshub-user>
MLFLOW_TRACKING_PASSWORD=<dagshub-token>
DAGSHUB_USER=<dagshub-user>
DAGSHUB_TOKEN=<dagshub-token>

# ---------- ops (Team B) ----------
JENKINS_ADMIN_PASSWORD=change-me
GITHUB_REPO_URL=https://github.com/<org>/triageiq.git
# fine-grained, read-only contents
GITHUB_TOKEN=
# see Team B guide B1
DOCKER_SOCK_GID=0
# long random string
RETRAIN_WEBHOOK_TOKEN=
GRAFANA_ADMIN_PASSWORD=change-me
# named Cloudflare tunnel only (B5)
TUNNEL_TOKEN=

# ---------- common ----------
LOG_LEVEL=INFO
# plain password of the "smoke" user in GATEWAY_HTPASSWD (smoke test + Jenkins)
SMOKE_PASSWORD=
